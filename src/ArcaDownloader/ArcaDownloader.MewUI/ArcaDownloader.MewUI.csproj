<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>ArcaDownloader.MewUI</RootNamespace>
    <AssemblyName>ArcaDownloader.MewUI</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <MewUIBackend>Gdi</MewUIBackend>
    <ApplicationIcon>..\arca_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ArcaDownloader.Core\ArcaDownloader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Windows" Version="0.18.1" />
    <PackageReference Include="Aprillz.MewUI.WebView2.Win32" Version="0.18.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\arca_icon.png" LogicalName="arca_icon.png" />
    <None Include="..\arca_icon.ico" Link="arca_icon.ico" />
  </ItemGroup>

  <Target Name="RemovePublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishSymbols)" />
  </Target>
</Project>
